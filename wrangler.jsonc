// Cloudflare settings: publish the static website in the "site" folder,
// with a small Worker (worker/index.js) that answers /api/visitors for the footer's visitor count.
{
  "name": "ai-skills-cafe",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // the visitor count lives in one Durable Object (included in Cloudflare's free plan)
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Counter"] }]
}
